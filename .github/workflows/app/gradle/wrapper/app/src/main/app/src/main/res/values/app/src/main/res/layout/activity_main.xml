<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#0a0a0a">

    <TextView
        android:text="ZX PAINEL"
        android:textColor="#FF0000"
        android:textSize="28sp"
        android:textStyle="bold"
        android:letterSpacing="0.3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:text="Free Fire External"
        android:textColor="#888888"
        android:textSize="13sp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="40dp"/>

    <TextView
        android:id="@+id/tv_status"
        android:text="Aguardando configuração..."
        android:textColor="#AAAAAA"
        android:textSize="12sp"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"/>

    <Button
        android:id="@+id/btn_shizuku"
        android:text="1. Conectar Shizuku"
        android:textColor="#FFFFFF"
        android:backgroundTint="#CC880000"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginBottom="12dp"/>

    <Button
        android:id="@+id/btn_overlay"
        android:text="2. Permitir Overlay"
        android:textColor="#FFFFFF"
        android:backgroundTint="#CC880000"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginBottom="12dp"/>

    <Button
        android:id="@+id/btn_start"
        android:text="▶  INICIAR PAINEL"
        android:textColor="#FFFFFF"
        android:backgroundTint="#CC440000"
        android:textStyle="bold"
        android:layout_width="match_parent"
        android:layout_height="56dp"/>

    <TextView
        android:text="v1.0 — ZX"
        android:textColor="#444444"
        android:textSize="10sp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"/>

</LinearLayout>
